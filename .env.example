# =========================================================
#  MODELLO delle chiavi necessarie.
#  Copia questo file, rinominalo ".env" e inserisci i valori veri.
#  Il file ".env" resta solo sul tuo PC (mai su GitHub).
# =========================================================

# --- AI (OpenRouter) ---
OPENAI_API_KEY=
OPENAI_API_BASE=https://openrouter.ai/api/v1
MODEL_NAME=qwen/qwen-2.5-72b-instruct

# --- Database vettoriale / Memoria clienti (Qdrant) ---
QDRANT_URL=
QDRANT_API_KEY=

# --- Ricerca web competitor (Serper) ---
SERPER_API_KEY=

# --- Database app + login utenti (Supabase) — serve dalla Fase 1 ---
SUPABASE_URL=
SUPABASE_KEY=

# --- Report Business Manager (Meta / Google) — serve dalle Fasi 5-6 ---
META_SYSTEM_USER_TOKEN=
GOOGLE_ADS_DEVELOPER_TOKEN=
GOOGLE_ADS_REFRESH_TOKEN=
